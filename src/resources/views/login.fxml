<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LoginController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">

    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>

    <VBox alignment="CENTER" spacing="15"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">
        <padding>
            <Insets top="35" right="45" bottom="35" left="45"/>
        </padding>

        <Label text="🏭" style="-fx-font-size: 48px;"/>

        <Label fx:id="labelBienvenue" text="Performance Tracker"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

        <Label fx:id="labelSousTitre" text="Connexion"
               style="-fx-font-size: 14px; -fx-text-fill: #666;"/>

        <Separator prefWidth="260"/>

        <!-- Panneau de connexion -->
        <VBox fx:id="panneauConnexion" spacing="12" alignment="CENTER">
            <TextField fx:id="champIdentifiant" promptText="Identifiant" prefWidth="260"
                       style="-fx-font-size: 14px; -fx-padding: 10;"/>

            <PasswordField fx:id="champMotDePasse" promptText="Mot de passe" prefWidth="260"
                           style="-fx-font-size: 14px; -fx-padding: 10;"/>

            <Button fx:id="btnConnexion" text="Se connecter" prefWidth="260"
                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

        <!-- Panneau de première utilisation : création du compte administrateur -->
        <VBox fx:id="panneauPremiereUtilisation" spacing="12" alignment="CENTER"
              visible="false" managed="false">

            <Label text="Aucun compte n'existe encore. Créez le compte administrateur."
                   wrapText="true" maxWidth="280"
                   style="-fx-font-size: 13px; -fx-text-fill: #333;"/>

            <TextField fx:id="champNouvelIdentifiant" promptText="Identifiant administrateur"
                       prefWidth="260" style="-fx-font-size: 14px; -fx-padding: 10;"/>

            <PasswordField fx:id="champNouveauMotDePasse" promptText="Mot de passe"
                           prefWidth="260" style="-fx-font-size: 14px; -fx-padding: 10;"/>

            <PasswordField fx:id="champConfirmation" promptText="Confirmer le mot de passe"
                           prefWidth="260" style="-fx-font-size: 14px; -fx-padding: 10;"/>

            <Label text="Au moins 8 caractères, mêlant lettres et chiffres."
                   wrapText="true" maxWidth="280"
                   style="-fx-font-size: 11px; -fx-text-fill: #888;"/>

            <Button fx:id="btnCreerCompte" text="Créer le compte" prefWidth="260"
                    style="-fx-background-color: #764ba2; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

        <Label fx:id="labelMessage" text="" wrapText="true" maxWidth="280"
               style="-fx-font-size: 12px; -fx-text-fill: #c0392b;"/>
    </VBox>

    <Label text="Version 1.0 - Performance Tracker"
           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px;"/>
</VBox>
